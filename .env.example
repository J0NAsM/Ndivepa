# URL pública final, sin una barra final. Configúrala antes de indexar el sitio.
PUBLIC_BASE_URL=https://www.tu-dominio.com

# `production` añade cookies Secure y activa la configuración de despliegue.
NODE_ENV=production
HOST=0.0.0.0
PORT=4300

# Obligatoria al crear una instancia de producción nueva. No la guardes en Git.
INITIAL_ADMIN_EMAIL=admin@tu-dominio.com
INITIAL_ADMIN_PASSWORD=usa-una-contraseña-unica-de-al-menos-12-caracteres

# Idioma, zona horaria y modo de comercio.
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en,pt
TZ_DISPLAY=America/Asuncion
COMMERCE_MODE=AFFILIATE

# Umbrales del mantenimiento local, en días.
LINK_STALE_DAYS=14
PRICE_STALE_DAYS=30
ATTRIBUTION_WINDOW_DAYS=30
LOW_STOCK_THRESHOLD=5

# Conectores opcionales. Déjalos vacíos hasta tener las credenciales oficiales.
PAYMENT_PROVIDER=external
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
SMTP_URL=
SMTP_FROM=Ndivepa <no-reply@tu-dominio.com>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Almacenamiento. `DATA_DIR` mueve `db.json` fuera del repositorio (volumen,
# instancia aislada); `SNAPSHOT_DIR` hace lo mismo con los snapshots previos a
# cada migración. `STORAGE_PRETTY=false` es el valor por defecto en producción:
# guarda el documento compacto, sin sangría.
DATA_DIR=
SNAPSHOT_DIR=
STORAGE_PRETTY=
SNAPSHOT_KEEP=10
BACKUP_KEEP=20

# Semilla. Los datos base (monedas, países, roles, categorías) se siembran
# siempre. `SEED_DEMO` controla el catálogo afiliado de ejemplo, y está apagado
# en producción para que una instalación real no arranque con datos inventados.
SEED_ENABLED=true
SEED_DEMO=false

# Interruptores de funcionalidad.
FEATURE_GRAPHQL=true
FEATURE_WEBHOOKS=true
FEATURE_SEARCH=true
FEATURE_2FA=true
FEATURE_TREND_DISCOVERY=true

# Descubrimiento de demanda mediante el RSS oficial de Google Trends.
# Solo propone tendencias; para importar exige un programa afiliado aprobado y
# una URL afiliada real que ya contenga tu identificador de tracking.
GOOGLE_TRENDS_GEO=PY
DISCOVERY_TIMEOUT_MS=10000
DISCOVERY_CACHE_TTL_MS=600000

# Nombres de las cookies de sesión, si hay que convivir con otro servicio en el
# mismo dominio.
SESSION_COOKIE=ndivepa_session
CUSTOMER_SESSION_COOKIE=ndivepa_customer

# Activa la lectura de `X-Forwarded-For` solo detrás de un proxy de confianza:
# con esto encendido y sin proxy, cualquiera puede falsear su IP y esquivar los
# límites de peticiones.
TRUST_PROXY=false

# Límites HTTP y de seguridad. Los valores inválidos detienen el arranque.
MAX_BODY_BYTES=1000000
MAX_JSON_DEPTH=24
MAX_UPLOAD_BYTES=700000
MAX_URL_LENGTH=8192
MAX_QUERY_PARAMS=100
PASSWORD_MIN_LENGTH=12
SCRYPT_COST=16384
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
RATE_LOGIN_MAX=10
RATE_VIEW_MAX=120
RATE_CLICK_MAX=60
RATE_API_MAX=600
RATE_WRITE_MAX=120
CORS_ORIGINS=

# Tiempos del servidor y apagado ordenado, en milisegundos.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
JOBS_ENABLED=true
JOBS_TICK_MS=30000
